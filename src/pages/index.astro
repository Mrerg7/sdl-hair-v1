---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import ValuePillars from '../components/ValuePillars.astro';
import UseCasesSection from '../components/UseCasesSection.astro';
import MarketSection from '../components/MarketSection.astro';
import InquirySection from '../components/InquirySection.astro';
import ClosingSection from '../components/ClosingSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Nav />
  <Hero />
  <TrustBar />
  <ValuePillars />
  <UseCasesSection />
  <MarketSection />
  <InquirySection />
  <ClosingSection />
  <Footer />

  <script define:vars={{ email: 'sales@desertrich.com' }}>
    function submitInquiry(e) {
      e.preventDefault();
      const form = document.getElementById('inquiry-form');
      const submitBtn = form.querySelector('button[type="submit"]');
      const data = new FormData(form);
      const subject = encodeURIComponent('Acquisition Inquiry: sdl.hair');
      const body = encodeURIComponent(
        `Name: ${data.get('name')}\nEmail: ${data.get('email')}\nIntended use: ${data.get('use-case')}\nOffer: ${data.get('offer') || 'Not specified'}\n\n${data.get('message') || ''}`,
      );
      submitBtn.textContent = 'OPENING EMAIL...';
      submitBtn.disabled = true;
      window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
      window.setTimeout(() => {
        submitBtn.textContent = 'OPEN EMAIL TO SUBMIT';
        submitBtn.disabled = false;
      }, 1500);
    }
  </script>
</BaseLayout>
