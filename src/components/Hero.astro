---
import { SITE } from '../config/site';
---

<header class="relative min-h-[580px] sm:min-h-[620px] md:min-h-[680px] flex items-center overflow-hidden bg-slate-950">
  <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style={`background-image: url('${SITE.image}')`}>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/70 via-slate-950/35 to-slate-950/20"></div>
  </div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-16 sm:pt-8 md:pt-0 w-full">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-x-2 bg-white/10 backdrop-blur-md border border-white/20 px-3 sm:px-4 py-1.5 rounded-3xl mb-6 sm:mb-8">
        <div class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse shrink-0"></div>
        <span class="text-[10px] sm:text-xs font-semibold tracking-[1.5px] text-white/90">
          PREMIUM .HAIR DOMAIN &bullet; SCOTTSDALE LUXURY MARKET
        </span>
      </div>

      <h1 class="text-white">
        <span class="block font-bold tracking-tighter domain-name">sdl.hair</span>
      </h1>

      <p class="mt-3 sm:mt-4 max-w-lg text-lg sm:text-xl md:text-2xl text-white/90 tracking-tight">
        A short, memorable, industry-specific domain<br />for the hair &amp; beauty world.
      </p>

      <div class="mt-7 sm:mt-9 flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4">
        <a
          href="#acquire"
          class="px-8 sm:px-10 py-3.5 sm:py-4 bg-white text-slate-900 hover:bg-amber-50 font-semibold rounded-3xl text-sm sm:text-base text-center transition-all active:scale-[0.985] shadow-xl"
        >
          Inquire to Purchase
        </a>
        <a
          href="#why"
          class="px-8 py-3.5 sm:py-4 border border-white/30 hover:bg-white/10 text-white font-semibold rounded-3xl text-sm sm:text-base text-center transition-all"
        >
          Why sdl.hair
        </a>
      </div>

      <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-x-4 sm:gap-x-6 gap-y-2 text-[10px] sm:text-xs text-white/50">
        <div class="flex items-center gap-x-2">
          <span class="font-mono">SCOTTSDALE</span>
        </div>
        <div class="hidden sm:block w-px h-3 bg-white/30"></div>
        <div>Short &bullet; Brandable &bullet; Exact-match .hair</div>
      </div>
    </div>
  </div>
</header>
