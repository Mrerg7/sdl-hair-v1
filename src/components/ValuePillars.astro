---
import { getCollection } from 'astro:content';

const valuePillars = await getCollection('value-pillars');
const sorted = valuePillars.sort((a, b) => a.data.order - b.data.order);
---

<div class="max-w-5xl mx-auto px-4 sm:px-6 pt-14 sm:pt-16 pb-10 sm:pb-12" id="why">
  <div class="max-w-2xl">
    <div class="uppercase tracking-[2px] text-[10px] sm:text-xs font-semibold text-amber-700 mb-3">THE OPPORTUNITY</div>
    <h2 class="text-3xl sm:text-4xl md:text-5xl tracking-tighter font-semibold heading-serif">Own a standout<br />digital flagship in hair.</h2>
    <p class="mt-4 sm:mt-5 text-base sm:text-lg text-slate-600">
      sdl.hair is short, elegant, instantly memorable, and perfectly aligned with the multi-billion-dollar global hair
      care, salon, and beauty industry. The &ldquo;SDL&rdquo; prefix carries natural prestige — especially powerful when
      tied to Scottsdale, one of the wealthiest and most style-conscious markets in the United States.
    </p>
  </div>

  <div class="mt-10 sm:mt-12 grid sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-5">
    {sorted.map((pillar) => (
      <div class="value-card bg-white border border-slate-200 rounded-2xl sm:rounded-3xl p-5 sm:p-7">
        <div class="text-amber-700 text-[10px] sm:text-xs tracking-widest font-semibold mb-2 sm:mb-3">{pillar.data.tag}</div>
        <div class="font-semibold text-lg sm:text-xl tracking-tight">{pillar.data.title}</div>
        <p class="mt-2 sm:mt-3 text-sm text-slate-600">{pillar.data.description}</p>
      </div>
    ))}
  </div>
</div>
