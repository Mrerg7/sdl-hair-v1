---
import CtaButton from './CtaButton.astro';
---

<nav class="bg-white/95 backdrop-blur-md border-b border-slate-200 sticky top-0 z-50" aria-label="Primary navigation">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex justify-between items-center h-20">
      <div class="flex items-center gap-x-3">
        <div class="w-9 h-9 bg-slate-900 rounded-2xl flex items-center justify-center">
          <span class="text-white font-bold text-2xl tracking-tighter">SDL</span>
        </div>
        <div class="font-semibold text-xl tracking-tighter text-slate-900">
          sdl<span class="text-amber-700">.</span>hair
        </div>
      </div>

      <div class="hidden md:flex items-center gap-x-8 text-sm font-medium">
        <a href="#why" class="nav-link text-slate-600 hover:text-slate-900">Why This Domain</a>
        <a href="#perfect-for" class="nav-link text-slate-600 hover:text-slate-900">Perfect For</a>
        <a href="#acquire" class="nav-link text-slate-600 hover:text-slate-900">Acquire</a>
      </div>

      <div class="flex items-center gap-x-3">
        <CtaButton
          variant="default"
          size="sm"
          label="Make an Offer"
          href="#acquire"
        />
        <details class="relative md:hidden">
          <summary class="flex h-12 w-12 cursor-pointer list-none items-center justify-center rounded-2xl border border-slate-200 text-slate-700" aria-label="Open navigation menu">
            <span class="text-xl" aria-hidden="true">☰</span>
          </summary>
          <div class="absolute right-0 top-14 w-56 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl">
            <a href="#why" class="block rounded-xl px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50">Why This Domain</a>
            <a href="#perfect-for" class="block rounded-xl px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50">Perfect For</a>
            <a href="#acquire" class="block rounded-xl px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50">Acquire</a>
          </div>
        </details>
      </div>
    </div>
  </div>
</nav>
